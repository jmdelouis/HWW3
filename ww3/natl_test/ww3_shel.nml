! HWW3 North Atlantic: 12 h cold-start test with a homogeneous wind (no forcing files).
&DOMAIN_NML
  DOMAIN%START  = '20260101 000000'
  DOMAIN%STOP   = '20260101 120000'
/
&INPUT_NML
  INPUT%FORCING%WATER_LEVELS = 'F'
  INPUT%FORCING%CURRENTS     = 'F'
  INPUT%FORCING%WINDS        = 'H'
  INPUT%FORCING%ICE_CONC     = 'F'
/
&OUTPUT_TYPE_NML
  TYPE%FIELD%LIST = 'HS T02 FP DIR WND'
/
&OUTPUT_DATE_NML
  DATE%FIELD%START  = '20260101 000000'
  DATE%FIELD%STRIDE = '3600'
  DATE%FIELD%STOP   = '20260101 120000'
  DATE%RESTART      = '20260101 120000' '43200' '20260101 120000'
/
&HOMOG_COUNT_NML
  HOMOG_COUNT%N_WND = 1
/
&HOMOG_INPUT_NML
  HOMOG_INPUT(1)%NAME   = 'WND'
  HOMOG_INPUT(1)%DATE   = '20260101 000000'
  HOMOG_INPUT(1)%VALUE1 = 15.
  HOMOG_INPUT(1)%VALUE2 = 270.
  HOMOG_INPUT(1)%VALUE3 = 0.
/

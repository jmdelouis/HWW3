! HWW3 North Atlantic, January 2026: ERA5 wind, fixed January-mean ERA5 ice,
! hourly currents and sea level from Copernicus Marine GLOBAL_ANALYSISFORECAST_PHY_001_024;
! no boundary spectra yet; cold start.
&DOMAIN_NML
  DOMAIN%START  = '20260101 000000'
  DOMAIN%STOP   = '20260131 230000'
/
&INPUT_NML
  INPUT%FORCING%WATER_LEVELS = 'T'
  INPUT%FORCING%CURRENTS     = 'T'
  INPUT%FORCING%WINDS        = 'T'
  INPUT%FORCING%ICE_CONC     = 'T'
/
&OUTPUT_TYPE_NML
  TYPE%FIELD%LIST = 'HS T02 FP DIR WND ICE CUR WLV'
/
&OUTPUT_DATE_NML
  DATE%FIELD%START  = '20260101 000000'
  DATE%FIELD%STRIDE = '3600'
  DATE%FIELD%STOP   = '20260131 230000'
  DATE%RESTART      = '20260108 000000' '604800' '20260131 230000'
/

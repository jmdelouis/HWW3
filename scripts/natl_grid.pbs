#!/bin/bash
#PBS -N hww3_grid
#PBS -q omp
#PBS -l select=1:ncpus=8:mem=32g
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /home1/datawork/jmdeloui/HWW3/logs/grid_pbs.log
# Build the North Atlantic HEALPix grid on Datarmor (PBS).
# Run: qsub scripts/natl_grid.pbs
#  or: qsub -v CFG=configs/natl_v2_datarmor.json,GRID=grids/natl_v2 scripts/natl_grid.pbs
set -e
cd /home1/datawork/jmdeloui/HWW3
CFG=${CFG:-configs/natl_datarmor.json}
GRID=${GRID:-grids/natl}
export GRID
mkdir -p grids logs
# conda 4.7.12 python 3.7 (numpy 1.17, netCDF4 1.6)
PY=${HWW3_PYTHON:-/appli/anaconda/versions/4.7.12/bin/python}
if [ ! -f data/gebco/natl/meta.json ]; then
  /usr/bin/time -v $PY scripts/prep_gebco.py \
    data/gebco/GEBCO_2024.nc data/gebco/natl -100 45 0 80 --margin 3
fi
export RUSTUP_HOME=$HOME/stl-mpi/rustup CARGO_HOME=$HOME/stl-mpi/cargo
export PATH=$CARGO_HOME/bin:$PATH
export CARGO_TARGET_DIR=/home1/datawork/jmdeloui/HWW3/target_datarmor
cargo build --release --manifest-path hww3-grid/Cargo.toml
export RAYON_NUM_THREADS=8
/usr/bin/time -v $CARGO_TARGET_DIR/release/hww3-grid $CFG > ${GRID}_summary.json
# plotting subsets (numpy only; figures are made on the workstation)
$CARGO_TARGET_DIR/release/hww3-grid cells $GRID
PYTHON=$PY bash scripts/natl_extract.sh

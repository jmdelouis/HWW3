#!/bin/bash
#PBS -N hww3_build
#PBS -q omp
#PBS -l select=1:ncpus=8:mem=16g
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /home1/datawork/jmdeloui/HWW3/logs/build_ww3.log
# Build netCDF-Fortran 4.6.1, ParMETIS 4.0.3 (with METIS 5.1.0) and WW3 develop
# (PDLIB/METIS, ST4, implicit) on Datarmor with Intel 2020 (ifort 19.1.3) and
# Intel MPI 2019.9. The system netCDF-C 4.8.1 (parallel HDF5) is reused; its
# Fortran module was made by an old gfortran, hence the local netCDF-Fortran.
# Run: qsub scripts/build_ww3.pbs
set -e
R=/home1/datawork/jmdeloui/HWW3
SRC=$R/src
PREFIX=$R/opt
NC=/appli/netCDF/netcdf-4.8.1_impi-2017.2.174
mkdir -p $PREFIX
source /etc/profile.d/modules.sh 2>/dev/null || true
module purge
module load intel-comp/20 impi/2019.9.304
module list 2>&1
export CC=mpiicc CXX=mpiicpc FC=mpiifort F77=mpiifort
export PATH=$PREFIX/bin:$PATH
export LD_LIBRARY_PATH=$PREFIX/lib:$NC/lib:$LD_LIBRARY_PATH

# --- netCDF-Fortran ------------------------------------------------------------
if [ ! -f $PREFIX/lib/libnetcdff.so ]; then
  cd $SRC && rm -rf netcdf-fortran-4.6.1 && tar xzf netcdf-fortran-4.6.1.tar.gz
  cd netcdf-fortran-4.6.1
  CPPFLAGS="-I$NC/include" LDFLAGS="-L$NC/lib -Wl,-rpath,$NC/lib" \
    ./configure --prefix=$PREFIX --disable-static > configure.out 2>&1 || { tail -40 config.log; exit 1; }
  # skip the test suites (nf_test does not compile with ifort 19.1)
  sed -i -E '/^SUBDIRS *=/s/ nf[0-9]*_test[0-9]*//g' Makefile
  grep "^SUBDIRS" Makefile
  make -j8 > make.out 2>&1 || { tail -40 make.out; exit 1; }
  make install > install.out 2>&1
fi
$PREFIX/bin/nf-config --version --fc

# --- ParMETIS + METIS --------------------------------------------------------
if [ ! -f $PREFIX/lib/libparmetis.a ]; then
  module load cmake/3.15.0
  cd $SRC && rm -rf parmetis-4.0.3 && tar xzf parmetis-4.0.3.tar.gz
  cd parmetis-4.0.3
  (cd metis && make config cc=icc prefix=$PREFIX && make -j8 && make install) > metis.out 2>&1
  (make config cc=mpiicc cxx=mpiicpc prefix=$PREFIX && make -j8 && make install) > parmetis.out 2>&1
  module unload cmake/3.15.0
fi
ls $PREFIX/lib

# --- WW3 ---------------------------------------------------------------------
module load cmake/3.30.0
# Intel fpp drops the quotes of -DENDIANNESS='big_endian'; hard-code the parameter.
(cd $SRC/WW3 && git checkout -- model/src/constants.F90)
sed -i "/FILE_ENDIAN *= *ENDIANNESS/s/ENDIANNESS/'big_endian'/" $SRC/WW3/model/src/constants.F90
grep -n "FILE_ENDIAN =" $SRC/WW3/model/src/constants.F90
export METIS_PATH=$PREFIX
B=$R/build/ww3
rm -rf $B && mkdir -p $B && cd $B
cmake $SRC/WW3 -DSWITCH=$R/ww3/switch_hww3 -DCMAKE_INSTALL_PREFIX=$R/opt/ww3 \
  -DCMAKE_BUILD_TYPE=Release -DCMAKE_Fortran_COMPILER=mpiifort -DCMAKE_C_COMPILER=mpiicc \
  -DNetCDF_ROOT=$PREFIX -DNetCDF_C_ROOT=$NC -DNetCDF_Fortran_ROOT=$PREFIX
make -j8 2>&1 | grep -vE "warning #|^ *\^|^-+\^"
test ${PIPESTATUS[0]} -eq 0
make install > /dev/null
ls -la $R/opt/ww3/bin

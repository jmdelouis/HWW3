#!/bin/bash
#PBS -N hww3_xyp3h
#PBS -q sequentiel
#PBS -l mem=24g
#PBS -l walltime=00:40:00
#PBS -j oe
#PBS -o /home1/scratch/jmdeloui/HWW3/iri_pr3/xyp3_harness/xyp3h.log
#
# WW3 harness of the geographic propagation W3XYP3 (hww3-wave/harness/
# xyp3_harness.F90) compiled against the library of the IRI build (read
# only), run on the mod_def.ww3 and restart.ww3 of the PR3 reference
# (scripts/iri_pr3_ref.pbs) in $P, written to $D; then, on hpc,
#   hww3-pr3 WW3_GRID.nml --data DIR --nml NAMELISTS.nml --harness xyp3.bin
#   qsub [-v DTG=1800] scripts/xyp3_harness.pbs   (the .F90 copied into $D)
set -e
M=/home/datawork-WW3/MODEL/prod_forecast_Ifremer3_20260309_MTAG2
P=/home1/scratch/jmdeloui/HWW3/iri_pr3
D=$P/xyp3_harness
source /usr/share/Modules/3.2.10/init/bash
module purge
module load intel-comp/18 impi/2018.1.163
NC=/home/datawork-wave/NETCDF2019/INTEL/lib
export LD_LIBRARY_PATH=$NC:$LD_LIBRARY_PATH
cd $D
ln -sf $P/mod_def.ww3 mod_def.ww3
mpiifort -no-fma -g -traceback -i4 -real-size 32 -fp-model precise -assume byterecl -O2 \
  -I$M/model/src/mod $D/xyp3_harness.F90 -o $D/ww3_xyp3harness \
  $M/lib/libww3.a -L$NC -lnetcdff -lnetcdf -Wl,-rpath,$NC -Wl,-rpath-link,$NC
SECONDS=0
mpirun -np 1 $D/ww3_xyp3harness $P/restart.ww3 $D/xyp3.bin ${DTG:-1800}
echo "harness done in $SECONDS s"
ls -la xyp3.bin

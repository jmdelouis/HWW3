#!/bin/bash
#PBS -N hww3_exp_prep
#PBS -q sequentiel
#PBS -l mem=48g
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /home1/datawork/jmdeloui/HWW3/logs/natl_exp_setup.log
# Run directory for the explicit WW3 scheme on the nodes of an existing run with
# open-boundary spectra: ww3_grid with the explicit N scheme (EXPFSN, splitting of
# propagation, refraction, frequency shift and sources), and the forcing and
# nest.ww3 of SRC, which depend on the nodes only.
#   qsub -v SRC=natl_v4_jan2026_bnd,CUR=natl_v4_jan2026_cur,RUN=natl_v4_jan2026_exp,GRID=grids/natl_v4 scripts/natl_exp_setup.pbs
#   STOP='20260102 000000' shortens the run (test).
set -e
R=${R:-/home1/datawork/jmdeloui/HWW3}
NC=/appli/netCDF/netcdf-4.8.1_impi-2017.2.174
source /usr/share/Modules/3.2.10/init/bash
module purge
module load intel-comp/20 impi/2019.9.304
export LD_LIBRARY_PATH=$R/opt/lib:$NC/lib:$LD_LIBRARY_PATH
export I_MPI_FABRICS=shm
B=$R/opt/ww3/bin
G=$R/${GRID:-grids/natl_v4}
S=$R/runs/${SRC:-natl_v4_jan2026_bnd}
C=$R/runs/${CUR:-natl_v4_jan2026_cur}
D=$R/runs/${RUN:-natl_v4_jan2026_exp}
mkdir -p $D; cd $D
for f in natl.msh natl.obc ww3_grid.nml; do ln -sf $G/$f .; done
# Implicit namelists of the source run (with BETAMAX) switched to the explicit N scheme.
sed -e 's/^\( *EXPFSN *=\).*/\1 T,/' -e 's/^\( *IMPTOTAL *=\).*/\1 F,/' \
    -e 's/^\( *IMPREFRACTION *=\).*/\1 F,/' -e 's/^\( *IMPFREQSHIFT *=\).*/\1 F,/' \
    -e 's/^\( *IMPSOURCE *=\).*/\1 F,/' \
    -e 's/^! namelists generated by hww3-grid.*/! hww3-grid namelists switched to the explicit N scheme (EXPFSN)/' \
    $C/namelists_natl.nml > namelists_natl.nml
grep -E "EXPFSN|IMPTOTAL|IMPREFRACTION|IMPFREQSHIFT|IMPSOURCE|BETAMAX" namelists_natl.nml
t0=$(date +%s)
$B/ww3_grid > ww3_grid.out 2>&1 || { tail -40 ww3_grid.out; exit 1; }
echo "ww3_grid: $(( $(date +%s)-t0 )) s"
grep -E "Type of scheme|betamax|sea points|boundary points" ww3_grid.out | head
for f in wind.ww3 ice.ww3 current.ww3 level.ww3 nest.ww3; do ln -sf $(readlink -f $S/$f) .; done
cp $S/ST4TABUHF2.bin $S/ww3_ounf.nml .
STOP=${STOP:-20260131 230000}
sed "s/20260131 230000/$STOP/g" $S/ww3_shel.nml > ww3_shel.nml
sed "s/20260131 230000/$STOP/g" $S/ww3_ounf.nml > ww3_ounf.nml
grep -E "STOP|RESTART" ww3_shel.nml
ls -la

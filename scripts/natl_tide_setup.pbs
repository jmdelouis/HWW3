#!/bin/bash
#PBS -N hww3_tide_prep
#PBS -q sequentiel
#PBS -l mem=32g
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -o /home1/scratch/jmdeloui/HWW3/logs/natl_tide_setup.log
# Run directory for the reference run (grid v4, open-boundary spectra) with the
# FES2014 tide added to the Copernicus Marine currents and sea level
# (scripts/fes_tides.py, needs pyTMD in $R/pylib), then ww3_prnc on the nodes.
# Wind, ice, nest.ww3 and namelists come from SRC.
#   S=/home1/scratch/jmdeloui/HWW3
#   J=$(qsub -v R=$S scripts/natl_tide_setup.pbs)
#   qsub -W depend=afterok:$J -v R=$S,RUN=natl_v4_jan2026_tide -o $S/logs/natl_v4_tide_run.log scripts/natl_v2_run.pbs
set -e
R=${R:-/home1/datawork/jmdeloui/HWW3}
NC=/appli/netCDF/netcdf-4.8.1_impi-2017.2.174
source /usr/share/Modules/3.2.10/init/bash
module purge
module load intel-comp/20 impi/2019.9.304
export LD_LIBRARY_PATH=$R/opt/lib:$NC/lib:$LD_LIBRARY_PATH
export I_MPI_FABRICS=shm
B=$R/opt/ww3/bin
S=$R/runs/${SRC:-natl_v4_jan2026_bnd}
D=$R/runs/${RUN:-natl_v4_jan2026_tide}
mkdir -p $D; cd $D
for f in mod_def.ww3 wind.ww3 ice.ww3 nest.ww3 natl.msh natl.obc; do ln -sf $(readlink -f $S/$f) .; done
cp $S/ST4TABUHF2.bin $S/ww3_ounf.nml .
sed 's|^! hourly currents and sea level from Copernicus Marine GLOBAL_ANALYSISFORECAST_PHY_001_024;|! hourly currents and sea level from Copernicus Marine GLOBAL_ANALYSISFORECAST_PHY_001_024 plus the FES2014 tide;|' \
  $S/ww3_shel.nml > ww3_shel.nml
head -3 ww3_shel.nml
if [ ! -s level.nc ]; then
  t0=$(date +%s)
  PYTHONPATH=$R/pylib $R/venv/bin/python $R/scripts/fes_tides.py $R/runs/natl_jan2026_cur .
  echo "fes_tides: $(( $(date +%s)-t0 )) s"
fi
cp $R/ww3/natl_jan2026/ww3_prnc_current.nml $R/ww3/natl_jan2026/ww3_prnc_level.nml .
for k in current level; do
  t0=$(date +%s)
  cp ww3_prnc_$k.nml ww3_prnc.nml
  $B/ww3_prnc > ww3_prnc_$k.out 2>&1
  echo "ww3_prnc $k: $(( $(date +%s)-t0 )) s"; tail -4 ww3_prnc_$k.out
done
rm -f ww3_prnc.nml
ls -la
